# ==============================================================================
# AI Restaurant Agent - Environment Configuration
# ==============================================================================

# --- Server & Core Security ---
APP_ENV=development
SERVER_BASE_URL=http://localhost:8000
SECRET_KEY=super_secret_restaurant_key_change_me_in_prod
ADMIN_API_KEY=admin_secret_token_12345
TOKEN_EXPIRY_MINUTES=45

# --- LLM Engine (Groq is the primary engine) ---
LLM_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Ollama / Local LLM (Fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Embeddings & Vector DB (Qdrant) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/processed/qdrant_storage
QDRANT_COLLECTION=restaurant_kb

# --- Database (SQLite Ground Truth) ---
DATABASE_URL=sqlite:///./data/processed/orders.db

# --- Email & SMTP (Verification & Marketing) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=orders@dhakaspicehouse.com
SMTP_FROM_NAME="Dhaka Spice House"
SMTP_USE_TLS=true
# Set SMTP_MOCK_MODE=true to save emails to data/emails/ without sending real emails
SMTP_MOCK_MODE=true
EMAILS_DIR=./data/emails

# --- Dedicated Kitchen Thermal POS Printer ---
# Options: "mock" (writes receipt text & PDF to disk), "network" (ESC/POS over TCP 9100), "windows" (win32print spooler)
PRINTER_MODE=mock
PRINTER_IP=192.168.1.200
PRINTER_PORT=9100
PRINTER_WINDOWS_NAME="POS-80"
RECEIPTS_DIR=./data/receipts

# --- Google Sheets CRM & Reporting ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
GOOGLE_SHEET_TITLE="Dhaka Spice House Orders & Leads"
SHEETS_BACKUP_DIR=./data/sheets_backup

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- Restaurant Info & Defaults ---
RESTAURANT_NAME="Dhaka Spice House"
RESTAURANT_PHONE="+880 1700-000000"
RESTAURANT_ADDRESS="House 42, Road 11, Banani, Dhaka"
DELIVERY_FEE=60.0

# --- Logging ---
LOG_LEVEL=INFO
