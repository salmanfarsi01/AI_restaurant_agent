# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Ollama (local LLM server: https://ollama.com) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# swap this to run the same bot on another model for your comparison table
# e.g. mistral:7b, qwen2.5:7b, gemma2:9b

# --- Embeddings (HuggingFace, run locally via sentence-transformers) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# alternatives: BAAI/bge-m3, jinaai/jina-embeddings-v3, sentence-transformers/LaBSE

# --- Hugging Face local model ---
# Set to a local model path or HF repo id (e.g., intel/phi-3b, gpt2, or a local GGML wrapper)
HUGGINGFACE_MODEL=gpt2
# Device: 'cpu' or CUDA device index like '0'
HUGGINGFACE_DEVICE=cpu

# --- Vector DB (Qdrant) ---
# Docker mode (recommended): run `docker compose up -d qdrant`, keep QDRANT_URL set
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Embedded mode (no Docker): set QDRANT_URL= (empty) and it'll persist to QDRANT_PATH instead
QDRANT_PATH=./data/processed/qdrant_db
QDRANT_COLLECTION=restaurant_kb

# --- App DB (orders) ---
DATABASE_URL=sqlite:///./data/processed/orders.db

# --- Misc ---
LOG_LEVEL=INFO
